# ============================================
# Livestream Assistant Agent - Environment Variables
# ============================================
# Copy this file to .env and customize as needed

# ============================================
# KAFKA CONFIGURATION
# ============================================
# For cluster mode (default)
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9094,kafka-2:9094,kafka-3:9094
# For single node dev mode, use:
# KAFKA_BOOTSTRAP_SERVERS=kafka-single:9092

KAFKA_CLUSTER_NAME=livestream-cluster
KAFKA_REPLICATION_FACTOR=3
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# AGENT CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
IS_APPLE_SILICON=false
USE_GPU=false
SENTIMENT_MODEL_NAME=sentimentdl_use_twitter
ENCODER_NAME=tfhub_use
INPUT_COL=comments
API_RELOAD=false
API_WORKERS=1

# ============================================
# CDC POSTGRESQL CONFIGURATION
# ============================================
CDC_POSTGRES_HOST=cdc-postgresql
CDC_POSTGRES_PORT=5432
CDC_POSTGRES_DB=cdc
CDC_POSTGRES_USER=cdc
CDC_POSTGRES_PASSWORD=cdc

# ============================================
# DATA WAREHOUSE POSTGRESQL CONFIGURATION
# ============================================
DWH_POSTGRES_HOST=postgres-dwh
DWH_POSTGRES_PORT=5432
DWH_POSTGRES_DB=dwh
DWH_POSTGRES_USER=dwh
DWH_POSTGRES_PASSWORD=dwh

# ============================================
# STREAMING ENRICHMENT CONFIGURATION
# ============================================
INPUT_TOPIC=tracking_postgres_cdc.public.comment_events
OUTPUT_TOPIC=streaming.enriched_events
KAFKA_CONSUMER_GROUP_ID=streaming-enrichment-group
# API_BASE_URL for streaming enrichment service:
# - Use http://host.docker.internal:8000 when API runs on host (via python main.py)
# - Use http://livestream-agent:8000 when API runs in Docker container
STREAMING_API_BASE_URL=http://host.docker.internal:8000
API_TIMEOUT_SECONDS=10.0
API_MAX_RETRIES=3

# ============================================
# LLM INSIGHT SERVICE CONFIGURATION
# ============================================
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
LLM_COMBINED_STATS_TOPIC=streaming.combined_stats
LLM_OUTPUT_TOPIC=streaming.llm_insights
LLM_CONSUMER_GROUP_ID=llm-insight-group
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0
