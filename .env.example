# ============================================
# Livestream Assistant Agent - Local Environment Configuration
# ============================================
# This file is for LOCAL/HOST execution (python main_cdc.py, python main.py, init_ksql.sh)
# Copy this file to .env and customize as needed
# 
# Workflow:
# 1. docker compose --profile full up -d       (uses .env.docker for containers)
# 2. python main_cdc.py                        (uses this .env - localhost)
# 3. python main.py                            (uses this .env - localhost)
# 4. ./src/streaming/ksql/init_ksql.sh        (uses this .env - localhost)
# 5. docker compose --profile streaming up -d  (uses .env.docker for containers)

# ============================================
# PostgreSQL Configuration (CDC)
# ============================================
# Use localhost when running locally, cdc-postgresql when in Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdc
POSTGRES_USER=cdc
POSTGRES_PASSWORD=cdc

# ============================================
# Kafka Configuration
# ============================================
KAFKA_GROUP_ID=produce-group
KAFKA_OUTPUT_TOPICS=tracking.user_comments
# For local development (outside Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
# For Docker containers, use:
# KAFKA_BOOTSTRAP_SERVERS=kafka-1:9094,kafka-2:9094,kafka-3:9094
SCHEMA_REGISTRY_URL=http://localhost:8081

# ============================================
# Redis Configuration
# ============================================
# Use localhost when running locally, redis when in Docker
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Spark NLP Configuration
# ============================================
IS_APPLE_SILICON=false
USE_GPU=false
SENTIMENT_MODEL_NAME=sentimentdl_use_twitter
ENCODER_NAME=tfhub_use
INPUT_COL=comments
API_RELOAD=false
API_WORKERS=1

# ============================================
# LLM INSIGHT SERVICE CONFIGURATION
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
LLM_COMBINED_STATS_TOPIC=streaming.combined_stats
LLM_OUTPUT_TOPIC=streaming.llm_insights
LLM_CONSUMER_GROUP_ID=llm-insight-group
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0
