# ============================================
# Docker Environment Configuration
# ============================================
# This file is used by docker-compose.yaml for container environments
# Use this when running services inside Docker containers

# ============================================
# Kafka Configuration (Docker)
# ============================================
KAFKA_CLUSTER_NAME=livestream-cluster
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9094,kafka-2:9094,kafka-3:9094
KAFKA_REPLICATION_FACTOR=3
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_GROUP_ID=produce-group
KAFKA_OUTPUT_TOPICS=tracking.user_comments

# ============================================
# PostgreSQL Configuration (Docker)
# ============================================
POSTGRES_HOST=cdc-postgresql
POSTGRES_PORT=5432
POSTGRES_DB=cdc
POSTGRES_USER=cdc
POSTGRES_PASSWORD=cdc

# CDC PostgreSQL (alias for compatibility)
CDC_POSTGRES_HOST=cdc-postgresql
CDC_POSTGRES_PORT=5432
CDC_POSTGRES_DB=cdc
CDC_POSTGRES_USER=cdc
CDC_POSTGRES_PASSWORD=cdc

# Data Warehouse PostgreSQL
DWH_POSTGRES_HOST=postgres-dwh
DWH_POSTGRES_PORT=5432
DWH_POSTGRES_DB=dwh
DWH_POSTGRES_USER=dwh
DWH_POSTGRES_PASSWORD=dwh

# ============================================
# Redis Configuration (Docker)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379


# ============================================
# Data Paths
# ============================================
REVIEW_PARQUET_PATH=data/user_comments.parquet
BATCH_SIZE=10
MAX_RECORDS=100

# ============================================
# Streaming Enrichment Configuration (Docker)
# ============================================
INPUT_TOPIC=tracking_postgres_cdc.public.comment_events
OUTPUT_TOPIC=streaming.enriched_events
KAFKA_CONSUMER_GROUP_ID=streaming-enrichment-group
# API_BASE_URL: Use host.docker.internal:8000 when API runs on host (via main.py)
# Change to http://livestream-agent:8000 if running API in Docker container
STREAMING_API_BASE_URL=http://host.docker.internal:8000
API_TIMEOUT_SECONDS=10.0
API_MAX_RETRIES=3

# ============================================
# LLM Insight Service Configuration (Docker)
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
LLM_GENDER_STATS_TOPIC=streaming.gender_stats
LLM_SENTIMENT_STATS_TOPIC=streaming.sentiment_stats
LLM_OUTPUT_TOPIC=streaming.llm_insights
LLM_WINDOW_TIMEOUT_SECONDS=30
LLM_CONSUMER_GROUP_ID=llm-insight-group
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0
